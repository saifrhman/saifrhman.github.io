---
import { Font } from 'astro:assets';
import Seo from '@/components/Seo.astro';
import Navigation from '@/components/Navigation.astro';
import Footer from '@/components/Footer.astro';
import '@/styles/tokens.css';
import '@/styles/base.css';
import '@/styles/figures.css';

interface Props {
  title?: string | undefined;
  description?: string | undefined;
  image?: string | undefined;
  type?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
}

const props = Astro.props;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Apply a saved theme before first paint to avoid a flash.
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch {
        // Storage unavailable (private mode): fall back to the system theme.
      }
    </script>
    <Font cssVariable="--font-newsreader" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-plex-sans" preload />
    <Font cssVariable="--font-plex-mono" />
    <Seo {...props} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Navigation />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '@/scripts/theme';
    </script>
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
