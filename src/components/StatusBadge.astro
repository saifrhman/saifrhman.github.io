---
import type { Status, Venue } from '@/data/types';
import { STATUS_LABEL, STATUS_TONE, venueLabel, statusProblems } from '@/lib/status';

interface Props {
  status: Status;
  venue?: Venue | undefined;
  note?: string | undefined;
  /** Render venue on its own line (research cards) or inline (lists). */
  layout?: 'stack' | 'inline';
}

const { status, venue, note, layout = 'inline' } = Astro.props;

const problems = statusProblems(status, venue);
if (problems.length > 0) {
  throw new Error(`Inconsistent status metadata: ${problems.join('; ')}`);
}
const tone = STATUS_TONE[status];
---

<p class:list={['status', `is-${layout}`]} data-tone={tone}>
  <span class="badge"><span class="dot" aria-hidden="true"></span>{STATUS_LABEL[status]}</span>
  {
    venue && (
      <span class="venue">
        {venue.fullName ? <abbr title={venue.fullName}>{venueLabel(venue)}</abbr> : venueLabel(venue)}
      </span>
    )
  }
  {note && <span class="note">{note}</span>}
</p>

<style>
  .status {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--color-ink-2);
  }

  .is-stack {
    flex-direction: column;
    gap: var(--space-1);
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--color-ink);
  }

  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    flex: none;
    background: var(--tone);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--tone) 18%, transparent);
  }

  [data-tone='progress'] {
    --tone: var(--color-status-progress);
  }

  [data-tone='review'] {
    --tone: var(--color-status-review);
  }

  [data-tone='done'] {
    --tone: var(--color-status-done);
  }

  [data-tone='neutral'] {
    --tone: var(--color-ink-3);
  }

  [data-tone='neutral'] .dot {
    background: transparent;
    box-shadow: inset 0 0 0 1.5px var(--tone);
  }

  .venue,
  .note {
    color: var(--color-ink-2);
  }

  /* Separators trail each item, so a wrapped line never starts with one. */
  .is-inline > :not(:last-child)::after {
    content: '·';
    margin-left: var(--space-3);
    color: var(--color-ink-3);
  }

  abbr {
    text-decoration: underline dotted;
    text-underline-offset: 0.2em;
  }
</style>
