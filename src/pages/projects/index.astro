---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { projects } from '@/data/projects';
import { site } from '@/data/site';
---

<BaseLayout
  title="Projects"
  description="ML projects: evidence-checked RAG over the FIA F1 regulations, chest X-ray classification, weakly supervised receipt extraction, a football data platform."
>
  <div class="container page">
    <SectionHeading
      level={1}
      title="Selected projects"
      description="Chosen for what was technically interesting rather than for coverage. Unfinished parts are stated on each card."
    />
    <div class="list">
      {projects.map((project) => <ProjectCard project={project} headingLevel={2} />)}
    </div>
    <p class="more">
      More repositories are on <a href={site.github} rel="noopener">GitHub</a>.
    </p>
  </div>
</BaseLayout>

<style>
  .page {
    padding-top: clamp(3rem, 2rem + 4vw, 5rem);
  }

  .more {
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: var(--border);
    font-size: var(--text-sm);
    color: var(--color-ink-3);
  }
</style>
