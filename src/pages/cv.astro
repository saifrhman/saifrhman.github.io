---
/**
 * Printable CV, generated from the same data as the rest of the site so the two
 * cannot drift apart. `npm run cv:pdf` prints this page to
 * public/cv/saif-ur-rehman-cv.pdf.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/data/site';
import { research } from '@/data/research';
import { projects } from '@/data/projects';
import { education, experience, competitions, skills } from '@/data/experience';
import { STATUS_LABEL, venueLabel } from '@/lib/status';
import { firstSentence } from '@/lib/text';

const statusLine = (r: (typeof research)[number]) =>
  [STATUS_LABEL[r.status], r.venue ? venueLabel(r.venue) : null, r.statusNote ?? null].filter(Boolean).join(' · ');
const host = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
---

<BaseLayout
  title="CV"
  description="Curriculum vitae of Saif Ur Rehman: research, education, experience, selected projects and skills."
>
  <div class="container page">
    <div class="toolbar">
      <p class="label">Curriculum vitae</p>
      <ul class="downloads" role="list">
        {
          site.cv.resume && (
            <li>
              <a class="arrow-link" href={site.cv.resume} type="application/pdf">
                Résumé (PDF)
              </a>
            </li>
          )
        }
        {
          site.cv.pdf && (
            <li>
              <a class="arrow-link" href={site.cv.pdf} download>
                This page as PDF
              </a>
            </li>
          )
        }
      </ul>
    </div>

    <article class="cv">
      <header class="cv-head">
        <h1>{site.name}</h1>
        <p class="cv-role">{site.role}</p>
        <p class="cv-contact">
          <span>{site.location}</span>
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <a href={site.github}>{host(site.github)}</a>
          <a href={site.linkedin}>{host(site.linkedin)}</a>
          <a href={site.url}>{host(site.url)}</a>
        </p>
      </header>

      <section aria-labelledby="cv-education">
        <h2 id="cv-education">Education</h2>
        {
          education.map((e) => (
            <div class="item">
              <div class="item-head">
                <h3>
                  {e.degree}, <span class="org">{e.institution}</span>
                </h3>
                <p class="dates">
                  {e.start} – {e.end}
                </p>
              </div>
              {e.detail && <p>{e.detail}</p>}
            </div>
          ))
        }
      </section>

      <section aria-labelledby="cv-research">
        <h2 id="cv-research">Research</h2>
        {
          research.map((r) => (
            <div class="item">
              <div class="item-head">
                <h3>{r.title}</h3>
                <p class="dates">{r.year}</p>
              </div>
              <p class="status">{statusLine(r)}</p>
              <p>{r.question}</p>
              {r.role && <p class="muted">{r.role}</p>}
            </div>
          ))
        }
      </section>

      <section aria-labelledby="cv-experience">
        <h2 id="cv-experience">Experience</h2>
        {
          experience.map((x) => (
            <div class="item">
              <div class="item-head">
                <h3>
                  {x.role}, <span class="org">{x.organisation}</span>
                </h3>
                <p class="dates">
                  {x.start} – {x.end}
                </p>
              </div>
              <p>{x.summary}</p>
            </div>
          ))
        }
      </section>

      <section aria-labelledby="cv-projects">
        <h2 id="cv-projects">Selected projects</h2>
        {
          projects.map((p) => (
            <div class="item">
              <div class="item-head">
                <h3>{p.title}</h3>
                <p class="dates repo">
                  <a href={p.repo}>{host(p.repo)}</a>
                </p>
              </div>
              <p>{firstSentence(p.description)}</p>
            </div>
          ))
        }
      </section>

      <section aria-labelledby="cv-competitions">
        <h2 id="cv-competitions">Competitions</h2>
        <ul class="compact">
          {
            competitions.map((c) => (
              <li>
                <strong>{c.title}</strong>: {c.detail}
              </li>
            ))
          }
        </ul>
      </section>

      <section aria-labelledby="cv-skills">
        <h2 id="cv-skills">Skills</h2>
        <ul class="compact">
          {
            skills.map((g) => (
              <li>
                <strong>{g.title}</strong>: {g.items.join(', ')}
              </li>
            ))
          }
        </ul>
      </section>
    </article>
  </div>
</BaseLayout>

<style>
  .page {
    padding-top: clamp(2.5rem, 2rem + 3vw, 4rem);
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    max-width: 52rem;
    margin: 0 auto var(--space-5);
    font-size: var(--text-sm);
  }

  .downloads {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
  }

  .cv {
    max-width: 52rem;
    margin: 0 auto;
    padding: clamp(1.25rem, 1rem + 3vw, 3.5rem);
    background: var(--color-surface);
    border: var(--border);
    border-radius: var(--radius-lg);
  }

  .cv-head {
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-ink);
  }

  h1 {
    font-size: var(--text-2xl);
    font-weight: 450;
  }

  .cv-role {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-md);
    color: var(--color-ink-2);
  }

  .cv-contact {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-ink-2);
  }

  .cv-contact a {
    overflow-wrap: anywhere;
  }

  section {
    margin-top: var(--space-6);
  }

  h2 {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-accent);
    padding-bottom: var(--space-2);
    margin-bottom: var(--space-2);
    border-bottom: var(--border);
  }

  .item {
    padding-block: var(--space-2);
    font-size: var(--text-sm);
    line-height: 1.5;
    break-inside: avoid;
  }

  .item-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0 var(--space-4);
  }

  h3 {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.4;
  }

  .org {
    font-weight: 400;
  }

  .dates {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-ink-3);
    white-space: nowrap;
  }

  .repo {
    white-space: normal;
    overflow-wrap: anywhere;
  }

  .item p:not(.dates) {
    color: var(--color-ink-2);
    margin-top: 0.15rem;
  }

  .status {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-ink) !important;
  }

  .muted {
    color: var(--color-ink-3) !important;
  }

  .compact {
    display: grid;
    gap: var(--space-2);
    padding-left: 0;
    list-style: none;
    font-size: var(--text-sm);
    color: var(--color-ink-2);
  }

  .compact strong {
    color: var(--color-ink);
    font-weight: 600;
  }

  @media print {
    @page {
      size: A4;
      margin: 13mm 14mm;
    }

    :global(.site-header),
    :global(.site-footer),
    :global(.skip-link),
    .toolbar {
      display: none !important;
    }

    :global(html),
    :global(body) {
      background: #fff !important;
      font-size: 9.6pt;
    }

    .page {
      padding: 0;
      max-width: none;
    }

    .cv {
      max-width: none;
      padding: 0;
      border: 0;
      background: #fff;
    }

    .cv a {
      text-decoration: none;
    }

    h2 {
      color: #8f3514;
    }

    section {
      margin-top: 4.5mm;
    }
  }
</style>
